<Project Sdk="Microsoft.NET.Sdk">

  <!-- I keep the wire protocol in its own small library so the client and the server always speak exactly the same language. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ChatShared</RootNamespace>
    <AssemblyName>ChatShared</AssemblyName>
  </PropertyGroup>

</Project>
